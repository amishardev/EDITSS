{
  "name": "dietary-guide-ira-campaign",
  "version": "1.0.0",
  "private": true,
  "description": "Dietary Guide x IRA vertical ad campaign (Remotion)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "tsc --noEmit && remotion bundle src/index.ts --out-dir build",
    "typecheck": "tsc --noEmit",
    "render:01": "remotion render src/index.ts Ad01-Plate out/ad-01-plate.mp4",
    "render:02": "remotion render src/index.ts Ad02-LabelScan out/ad-02-label-scan.mp4",
    "render:03": "remotion render src/index.ts Ad03-AskIra out/ad-03-ask-ira.mp4",
    "render:04": "remotion render src/index.ts Ad04-IndianFood out/ad-04-indian-food.mp4",
    "render:05": "remotion render src/index.ts Ad05-SmallHabits out/ad-05-small-habits.mp4",
    "render:06": "remotion render src/index.ts Ad06-BrandIntro out/ad-06-brand-intro.mp4",
    "render:all": "npm run render:01 && npm run render:02 && npm run render:03 && npm run render:04 && npm run render:05 && npm run render:06 && npm run render:07 && npm run render:08 && npm run render:09 && npm run render:10 && npm run render:11",
    "still": "remotion still src/index.ts",
    "assets": "bash scripts/build-assets.sh",
    "render:07": "remotion render src/index.ts Ad07-IraHop out/ad-07-ira-hop.mp4",
    "music": "python3 -I scripts/compose.py public/audio",
    "finish": "bash scripts/finish.sh out/ad-0*.mp4",
    "qa": "python3 -I scripts/qa.py out",
    "qa:products": "SHEET=products-contact-sheet.jpg python3 -I scripts/qa.py out product-01-chana-jor product-02-rajma-jor-masala product-03-millet-granola product-04-mixed-seed-protein-bar product-05-almond-protein-bar product-06-digestion-tea wellness-treat-hero",
    "render:08": "remotion render src/index.ts Ad08-Personal out/ad-08-personal.mp4",
    "render:09": "remotion render src/index.ts Ad09-Metrics out/ad-09-metrics.mp4",
    "render:10": "remotion render src/index.ts Ad10-Story out/ad-10-story.mp4",
    "render:11": "remotion render src/index.ts Ad11-GenZRate out/ad-11-genz-rate.mp4",
    "render:new": "npm run render:08 && npm run render:09 && npm run render:10 && npm run render:11",
    "render:p01": "remotion render src/index.ts P01-ChanaJor out/product-01-chana-jor.mp4",
    "render:p02": "remotion render src/index.ts P02-RajmaJor out/product-02-rajma-jor-masala.mp4",
    "render:p03": "remotion render src/index.ts P03-MilletGranola out/product-03-millet-granola.mp4",
    "render:p04": "remotion render src/index.ts P04-MixedSeedBar out/product-04-mixed-seed-protein-bar.mp4",
    "render:p05": "remotion render src/index.ts P05-AlmondBar out/product-05-almond-protein-bar.mp4",
    "render:p06": "remotion render src/index.ts P06-DigestionTea out/product-06-digestion-tea.mp4",
    "render:p07": "remotion render src/index.ts P07-WellnessTreat out/wellness-treat-hero.mp4",
    "render:d01": "remotion render src/index.ts D01-DussehraApp out/dussehra-01-app.mp4",
    "render:d02": "remotion render src/index.ts D02-DussehraTreat out/dussehra-02-wellness-treat.mp4",
    "render:dussehra": "npm run render:d01 && npm run render:d02",
    "finish:dussehra": "bash scripts/finish.sh out/dussehra-*.mp4",
    "qa:dussehra": "SHEET=dussehra-contact-sheet.jpg python3 -I scripts/qa.py out dussehra-01-app dussehra-02-wellness-treat",
    "render:products": "npm run render:p01 && npm run render:p02 && npm run render:p03 && npm run render:p04 && npm run render:p05 && npm run render:p06 && npm run render:p07",
    "finish:products": "bash scripts/finish.sh out/product-*.mp4 out/wellness-treat-hero.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
