{
  "name": "amishar-moonlight-reels",
  "private": true,
  "version": "1.0.0",
  "description": "Procedural Remotion reel system for AMISHAR - Moonlight",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "board": "bash scripts/board.sh",
    "docs": "tsx scripts/export.ts",
    "sync-check": "python3 scripts/sync_check.py",
    "previews": "python3 scripts/previews.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3",
    "tsx": "4.20.3"
  }
}
